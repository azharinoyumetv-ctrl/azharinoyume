# Azyume Cut AI production environment
# Copy to .env.local for development. Never commit real secrets.

# Application
NEXT_PUBLIC_APP_URL=https://studio.azharinoyume.cloud
NEXT_PUBLIC_APP_NAME=Azyume Cut AI
NODE_ENV=production

# Authentication (email magic links)
NEXTAUTH_URL=https://studio.azharinoyume.cloud
NEXTAUTH_SECRET=generate_at_least_32_random_bytes
RESEND_API_KEY=re_...
EMAIL_FROM=Azyume Cut AI <noreply@azharinoyume.cloud>

# Database and queue
DATABASE_URL=postgresql://azyume:PASSWORD@127.0.0.1:5432/azyume_cut_ai
DATABASE_POOL_SIZE=10
# Dedicated logical database for Azyume BullMQ jobs.
REDIS_URL=redis://127.0.0.1:6379/1

# Cloudflare Access for /admin
CLOUDFLARE_ACCESS_REQUIRED=true

# Cloudflare R2
R2_ACCOUNT_ID=2a8a02a1e93b1a2bfdad66b0369cb2a0
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=azyumecutai

# Dedicated Azyume video-editing renderer (separate from WMP and NihongoMethodID)
RENDER_SERVICE_URL=http://127.0.0.1:4100
RENDER_SERVICE_SECRET=generate_an_azyume_only_32_byte_secret
FFPROBE_PATH=ffprobe

# DOKU Checkout (one-time project and pack payments)
DOKU_ENVIRONMENT=production
DOKU_CLIENT_ID=...
DOKU_SHARED_KEY=...

# Xendit Payment Requests v3 (project checkout, packs, and recurring card billing)
# The same merchant account used by another DagangOS product may be reused, but
# Azyume must have its own Payment Requests v3 webhook URL:
# https://studio.azharinoyume.cloud/api/webhooks/xendit
XENDIT_SECRET_KEY=xnd_production_...
XENDIT_WEBHOOK_SECRET=...

# Midtrans Snap (one-time project and pack payments)
# Set the payment notification URL in the Midtrans dashboard to:
# https://studio.azharinoyume.cloud/api/webhooks/midtrans
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_Client_Key=SB-Mid-client-...
MIDTRANS_Merchant_ID=...
MIDTRANS_Server_Key=SB-Mid-server-...

# Payoneer hosted payment link (optional; enabled from Admin > Settings)
# Payoneer credits are granted only after an administrator verifies the payment.
PAYONEER_PAYMENT_URL=https://payoneer.example/your-hosted-payment-link

# AI copy and brief generation
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PREMIUM=claude-sonnet-4-6
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_CHEAP=gemini-2.5-flash
GEMINI_MODEL_PREMIUM=gemini-2.5-pro
GEMINI_VIDEO_MODEL=gemini-2.5-flash
GEMINI_VIDEO_INPUT_USD_PER_MILLION_TOKENS=0.30
GEMINI_VIDEO_OUTPUT_USD_PER_MILLION_TOKENS=2.50
GEMINI_FLASH_INPUT_USD_PER_MILLION_TOKENS=0.30
GEMINI_FLASH_OUTPUT_USD_PER_MILLION_TOKENS=2.50
GEMINI_PRO_INPUT_USD_PER_MILLION_TOKENS=1.25
GEMINI_PRO_OUTPUT_USD_PER_MILLION_TOKENS=10.00
ANTHROPIC_HAIKU_INPUT_USD_PER_MILLION_TOKENS=1.00
ANTHROPIC_HAIKU_OUTPUT_USD_PER_MILLION_TOKENS=5.00
ANTHROPIC_SONNET_INPUT_USD_PER_MILLION_TOKENS=3.00
ANTHROPIC_SONNET_OUTPUT_USD_PER_MILLION_TOKENS=15.00
DEEPL_API_KEY=...

# Browser notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:support@azharinoyume.cloud

# Optional legacy n8n helpers (payment/render orchestration is not delegated)
N8N_BASE_URL=https://n8n.azharinoyume.cloud
N8N_WEBHOOK_SECRET=...

# Project contribution-margin guardrails (USD direct-cost ceilings)
COST_CAP_BASIC=3.00
COST_CAP_PLUS=9.00
COST_CAP_PREMIUM=26.00
