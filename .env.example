# ============================================================
# AZHARINOYUME — Environment Variables
# Copy this file to .env.local and fill in all values.
# Never commit .env.local to git.
# ============================================================

# App
NEXT_PUBLIC_APP_URL=https://azharinoyume.cloud
NEXT_PUBLIC_APP_NAME=Azharinoyume

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://azharinoyume.cloud
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD_HASH=bcrypt_hash_of_your_password

# Database (PostgreSQL)
DATABASE_URL=postgresql://azhar:PASSWORD@localhost:5432/azharinoyume

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2
R2_ACCOUNT_ID=your_cf_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=azharinoyume
R2_PUBLIC_URL=https://files.azharinoyume.cloud

# AI — Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PREMIUM=claude-sonnet-4-6

# Translation — DeepL
DEEPL_API_KEY=your_deepl_api_key

# Payment — Xendit
XENDIT_SECRET_KEY=xnd_production_...
XENDIT_WEBHOOK_SECRET=your_xendit_webhook_secret
XENDIT_PUBLIC_KEY=your_xendit_public_key

# Payment — Payoneer
PAYONEER_CLIENT_ID=your_payoneer_client_id
PAYONEER_CLIENT_SECRET=your_payoneer_client_secret
PAYONEER_PROGRAM_ID=your_payoneer_program_id

# Payment — Wise (manual by default)
WISE_API_KEY=your_wise_api_key
WISE_PROFILE_ID=your_wise_profile_id
WISE_WEBHOOK_SECRET=your_wise_webhook_secret

# Payment — Stripe (future, leave empty for now)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email — Resend
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@azharinoyume.cloud
EMAIL_SUPPORT=support@azharinoyume.cloud

# n8n webhook base URL
N8N_BASE_URL=https://n8n.azharinoyume.cloud
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret

# Admin dashboard
ADMIN_IP_WHITELIST=your_ip_address

# Cost caps (USD, must match 20% of package price)
COST_CAP_BASIC=9.80
COST_CAP_PLUS=29.80
COST_CAP_PREMIUM=79.80
COST_WARN_THRESHOLD=0.15
