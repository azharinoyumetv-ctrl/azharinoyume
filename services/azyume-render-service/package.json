{
  "name": "azyume-render-service",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Dedicated Remotion video-editing service for Azyume Cut AI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run src",
    "start": "node dist/server.js",
    "render:preview": "npx remotion preview src/index.ts",
    "render:studio": "npx remotion studio src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@remotion/bundler": "^4.0.503",
    "@remotion/cli": "^4.0.503",
    "@remotion/renderer": "^4.0.503",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.503",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  },
  "remotion": {
    "entryPoint": "src/index.ts"
  }
}
