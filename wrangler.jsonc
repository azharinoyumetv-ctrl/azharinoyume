{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "azyume-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://azcutai.azharinoyume.cloud",
    "NEXTAUTH_URL": "https://azcutai.azharinoyume.cloud",
    "CLOUDFLARE_DEPLOYMENT": "true"
  }
}
