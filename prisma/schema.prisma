  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@map("admin_actions")
}

model AdminApproval {
  id           String   @id @default(uuid())
  approvalType String   @map("approval_type")
  targetId     String   @map("target_id")
  adminId      String   @map("admin_id")
  decision     String
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@map("admin_approvals")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PricingProduct {
  id           String   @id @default(uuid())
  key          String   @unique
  kind         String
  name         String
  usdCents     Int      @map("usd_cents")
  credits      Int
  intervalDays Int?     @map("interval_days")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  quotes CheckoutQuote[]

  @@map("pricing_products")
}

model FxRate {
  id            String   @id
  baseCurrency  String   @map("base_currency")
  quoteCurrency String   @map("quote_currency")
  rate          Decimal  @db.Decimal(16, 6)
  version       Int      @default(1)
  effectiveAt   DateTime @map("effective_at")
  updatedBy     String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([baseCurrency, quoteCurrency])
  @@map("fx_rates")
}

model CheckoutQuote {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  productId      String   @map("product_id")
  usdCents       Int      @map("usd_cents")
  idrAmount      Int      @map("idr_amount")
  fxRate         Decimal  @map("fx_rate") @db.Decimal(16, 6)
  fxRateVersion  Int      @map("fx_rate_version")
  credits        Int
  status         String   @default("OPEN")
  idempotencyKey String   @unique @map("idempotency_key")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id])
  product  PricingProduct @relation(fields: [productId], references: [id])
  payments Payment[]
  order    Order?

  @@index([userId, status])
  @@map("checkout_quotes")
}

model Payment {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  quoteId              String    @map("quote_id")
  subscriptionId       String?   @map("subscription_id")
  provider             String
  providerPaymentId    String?   @map("provider_payment_id")
  referenceId          String    @unique @map("reference_id")
  idempotencyKey       String    @unique @map("idempotency_key")
  status               String    @default("CREATED")
  usdCents             Int       @map("usd_cents")
  idrAmount            Int       @map("idr_amount")
  currency             String    @default("IDR")
  paymentTokenId       String?   @map("payment_token_id")
  networkTransactionId String?   @map("network_transaction_id")
  metadata             Json      @default("{}")
  paidAt               DateTime? @map("paid_at")
  expiresAt            DateTime? @map("expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id])
  quote        CheckoutQuote   @relation(fields: [quoteId], references: [id])
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id])
  events       PaymentEvent[]
  creditLots   CreditLot[]
  refunds      PaymentRefund[]

  @@unique([provider, providerPaymentId])
  @@index([userId, status])
  @@map("payments")
}

model PaymentEvent {
  id              String    @id @default(uuid())
  paymentId       String?   @map("payment_id")
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  headersHash     String    @map("headers_hash")
  signatureValid  Boolean   @default(false) @map("signature_valid")
  payload         Json
  status          String    @default("RECEIVED")
  failureReason   String?   @map("failure_reason")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("payment_events")
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  productKey         String    @map("product_key")
  status             String    @default("PENDING")
  provider           String    @default("xendit")
  paymentTokenId     String?   @map("payment_token_id")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  nextBillingAt      DateTime? @map("next_billing_at")
  retryCount         Int       @default(0) @map("retry_count")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  payments   Payment[]
  creditLots CreditLot[]

  @@index([status, nextBillingAt])
  @@map("subscriptions")
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  availableCredits Int      @default(0) @map("available_credits")
  reservedCredits  Int      @default(0) @map("reserved_credits")
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id])
  lots         CreditLot[]
  entries      CreditLedgerEntry[]
  reservations CreditReservation[]

  @@map("wallets")
}

model CreditLot {
  id               String    @id @default(uuid())
  walletId         String    @map("wallet_id")
  userId           String    @map("user_id")
  paymentId        String?   @map("payment_id")
  subscriptionId   String?   @map("subscription_id")
  type             String
  issuedCredits    Int       @map("issued_credits")
  remainingCredits Int       @map("remaining_credits")
  expiresAt        DateTime? @map("expires_at")
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now()) @map("created_at")

  wallet       Wallet              @relation(fields: [walletId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
  payment      Payment?            @relation(fields: [paymentId], references: [id])
  subscription Subscription?       @relation(fields: [subscriptionId], references: [id])
  entries      CreditLedgerEntry[]

  @@unique([paymentId])
  @@index([walletId, status, expiresAt])
  @@map("credit_lots")
}

model CreditReservation {
  id              String   @id @default(uuid())
  walletId        String   @map("wallet_id")
  userId          String   @map("user_id")
  orderId         String   @map("order_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  status          String   @default("ACTIVE")
  reservedCredits Int      @map("reserved_credits")
  consumedCredits Int      @default(0) @map("consumed_credits")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  wallet  Wallet              @relation(fields: [walletId], references: [id])
  user    User                @relation(fields: [userId], references: [id])
  order   Order               @relation(fields: [orderId], references: [id])
  entries CreditLedgerEntry[]

  @@index([walletId, status])
  @@map("credit_reservations")
}

model CreditLedgerEntry {
  id             String   @id @default(uuid())
  walletId       String   @map("wallet_id")
  userId         String   @map("user_id")
  lotId          String?  @map("lot_id")
  reservationId  String?  @map("reservation_id")
  entryType      String   @map("entry_type")
  amount         Int
  availableAfter Int      @map("available_after")
  reservedAfter  Int      @map("reserved_after")
  idempotencyKey String   @unique @map("idempotency_key")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  wallet      Wallet             @relation(fields: [walletId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  lot         CreditLot?         @relation(fields: [lotId], references: [id])
  reservation CreditReservation? @relation(fields: [reservationId], references: [id])

  @@index([walletId, createdAt])
  @@map("credit_ledger_entries")
}

model PaymentRefund {
  id               String   @id @default(uuid())
  paymentId        String   @map("payment_id")
  providerRefundId String?  @unique @map("provider_refund_id")
  status           String   @default("PENDING")
  idrAmount        Int      @map("idr_amount")
  creditsReversed  Int      @map("credits_reversed")
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payment_refunds")
}

model UploadSession {
  id               String   @id @default(uuid())
  assetId          String   @unique @map("asset_id")
  userId           String   @map("user_id")
  orderId          String   @map("order_id")
  providerUploadId String   @map("provider_upload_id")
  status           String   @default("CREATED")
  partSizeBytes    Int      @map("part_size_bytes")
  totalSizeBytes   BigInt   @map("total_size_bytes")
  expectedParts    Int      @map("expected_parts")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  asset UploadedAsset @relation(fields: [assetId], references: [id])
  parts UploadPart[]

  @@index([userId, status])
  @@map("upload_sessions")
}

model UploadPart {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  partNumber Int      @map("part_number")
  etag       String?
  sizeBytes  Int?     @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

