generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String?
  role              String   @default("customer")
  preferredLanguage String   @default("en") @map("preferred_language")
  totpSecret        String?  @map("totp_secret")
  totpEnabled       Boolean  @default(false) @map("totp_enabled")
  passwordHash      String?  @map("password_hash")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  orders            Order[]
  invoices          Invoice[]
  testimonials      Testimonial[]
  adminActions      AdminAction[]
  adminApprovals    AdminApproval[]
  accounts          Account[]
  sessions          Session[]
  wallet            Wallet?
  checkoutQuotes    CheckoutQuote[]
  payments          Payment[]
  subscriptions     Subscription[]
  creditLots        CreditLot[]
  creditEntries     CreditLedgerEntry[]
  reservations      CreditReservation[]
  uploadedAssets    UploadedAsset[]
  auditEvents       AuditEvent[]        @relation("AuditActor")
  assignedReviews   ReviewTask[]        @relation("ReviewAssignee")
  gigDrafts         GigDraft[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  @@map("users")
}

model Order {
  id                     String    @id @default(uuid())
  orderNumber            String    @unique @map("order_number")
  userId                 String?   @map("user_id")
  customerEmail          String    @map("customer_email")
  customerName           String?   @map("customer_name")
  customerCompany        String?   @map("customer_company")
  package                String
  status                 String    @default("draft")
  purpose                String?
  audience               String?
  visualStyle            String?   @map("visual_style")
  mood                   String?
  editingPace            String?   @map("editing_pace")
  colorGrade             String?   @map("color_grade")
  captionStyle           String?   @map("caption_style")
  musicStyle             String?   @map("music_style")
  storyPriority          String?   @map("story_priority")
  mandatoryContent       String?   @map("mandatory_content")
  excludedContent        String?   @map("excluded_content")
  creativeFreedom        String?   @map("creative_freedom")
  targetDurationSeconds  Int?      @map("target_duration_seconds")
  briefStatus            String    @default("draft") @map("brief_status")
  briefAmbiguityScore    Int       @default(100) @map("brief_ambiguity_score")
  briefConfirmedAt       DateTime? @map("brief_confirmed_at")
  platform               String?
  aspectRatio            String?   @map("aspect_ratio")
  resolution             String    @default("1080p")
  frameRate              String    @default("30fps") @map("frame_rate")
  exportFormat           String    @default("MP4") @map("export_format")
  compression            String    @default("balanced")
  editingMode            String    @default("standard") @map("editing_mode")
  editorConfig           Json?     @map("editor_config")
  customerPromptOriginal String?   @map("customer_prompt_original")
  customerPromptLanguage String?   @map("customer_prompt_language")
  customerPromptEn       String?   @map("customer_prompt_en")
  addOns                 Json      @default("[]") @map("add_ons")
  totalPrice             Decimal   @map("total_price") @db.Decimal(10, 2)
  currency               String    @default("USD")
  manualReviewRequired   Boolean   @default(false) @map("manual_review_required")
  adminApproved          Boolean   @default(false) @map("admin_approved")
  queuePosition          Int?      @map("queue_position")
  revisionCount          Int       @default(0) @map("revision_count")
  maxRevisions           Int       @default(1) @map("max_revisions")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  quoteId                String?   @unique @map("quote_id")
  estimatedCredits       Int       @default(0) @map("estimated_credits")
  actualCredits          Int       @default(0) @map("actual_credits")
  idempotencyKey         String?   @unique @map("idempotency_key")

  user                User?                @relation(fields: [userId], references: [id])
  invoices            Invoice[]
  uploadedAssets      UploadedAsset[]
  r2Files             R2File[]
  editBriefs          EditBrief[]
  renders             Render[]
  revisions           Revision[]
  deliveryLinks       DeliveryLink[]
  costLogs            CostLog[]
  aiUsageLogs         AiUsageLog[]
  renderCostLogs      RenderCostLog[]
  storageCostLogs     StorageCostLog[]
  ledgerEntries       LedgerEntry[]
  profitReport        ProfitReport?
  queueJobs           QueueJob[]
  paymentTransactions PaymentTransaction[]
  quote               CheckoutQuote?       @relation(fields: [quoteId], references: [id])
  reservations        CreditReservation[]
  reviewTasks         ReviewTask[]
  draftLead           JobLead?
  mediaAnalyses       MediaAnalysis[]
  editPlans           EditPlan[]
  timelineManifests   TimelineManifest[]
  qualityChecks       QualityCheck[]

  @@index([briefStatus])
  @@map("orders")
}

model Invoice {
  id               String    @id @default(uuid())
  invoiceNumber    String    @unique @map("invoice_number")
  orderId          String    @map("order_id")
  userId           String?   @map("user_id")
  status           String    @default("draft")
  subtotal         Decimal   @db.Decimal(10, 2)
  discount         Decimal   @default(0) @db.Decimal(10, 2)
  total            Decimal   @db.Decimal(10, 2)
  currency         String    @default("USD")
  paymentMethod    String?   @map("payment_method")
  paymentReference String?   @map("payment_reference")
  paidAmount       Decimal?  @map("paid_amount") @db.Decimal(10, 2)
  paidAt           DateTime? @map("paid_at")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime? @map("expires_at")
  deliveryStatus   String    @default("pending") @map("delivery_status")
  pdfR2Key         String?   @map("pdf_r2_key")
  createdAt        DateTime  @default(now()) @map("created_at")

  order           Order                   @relation(fields: [orderId], references: [id])
  user            User?                   @relation(fields: [userId], references: [id])
  items           InvoiceItem[]
  transactions    PaymentTransaction[]
  reconciliations PaymentReconciliation[]
  refunds         Refund[]
  ledgerEntries   LedgerEntry[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
}

model PaymentProvider {
  id      String  @id @default(uuid())
  name    String  @unique
  enabled Boolean @default(false)
  mode    String  @default("auto")
  regions Json    @default("[]")
  config  Json    @default("{}")

  @@map("payment_providers")
}

model PaymentTransaction {
  id                   String   @id @default(uuid())
  invoiceId            String   @map("invoice_id")
  orderId              String   @map("order_id")
  provider             String
  gatewayTransactionId String?  @unique @map("gateway_transaction_id")
  amount               Decimal  @db.Decimal(10, 2)
  currency             String
  status               String
  rawWebhook           Json?    @map("raw_webhook")
  adminApprovedBy      String?  @map("admin_approved_by")
  createdAt            DateTime @default(now()) @map("created_at")

  invoice        Invoice                @relation(fields: [invoiceId], references: [id])
  order          Order                  @relation(fields: [orderId], references: [id])
  reconciliation PaymentReconciliation?

  @@map("payment_transactions")
}

model PaymentGatewayEvent {
  id              String    @id @default(uuid())
  provider        String
  eventType       String    @map("event_type")
  rawPayload      Json      @map("raw_payload")
  processed       Boolean   @default(false)
  providerEventId String?   @map("provider_event_id")
  headersHash     String?   @map("headers_hash")
  signatureValid  Boolean   @default(false) @map("signature_valid")
  processedAt     DateTime? @map("processed_at")
  failureReason   String?   @map("failure_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@map("payment_gateway_events")
}

model PaymentReconciliation {
  id                String   @id @default(uuid())
  transactionId     String   @unique @map("transaction_id")
  invoiceId         String   @map("invoice_id")
  reconciled        Boolean  @default(false)
  discrepancyAmount Decimal  @default(0) @map("discrepancy_amount") @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])
  invoice     Invoice            @relation(fields: [invoiceId], references: [id])

  @@map("payment_reconciliation")
}

model Refund {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  amount    Decimal  @db.Decimal(10, 2)
  currency  String
  reason    String?
  status    String   @default("pending")
  adminId   String?  @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("refunds")
}

model UploadedAsset {
  id             String    @id @default(uuid())
  orderId        String    @map("order_id")
  userId         String?   @map("user_id")
  r2Key          String    @map("r2_key")
  fileName       String?   @map("file_name")
  fileSizeBytes  BigInt?   @map("file_size_bytes")
  mimeType       String?   @map("mime_type")
  assetType      String    @map("asset_type")
  cloudUrl       String?   @map("cloud_url")
  status         String    @default("CREATED")
  checksumSha256 String?   @map("checksum_sha256")
  durationMs     Int?      @map("duration_ms")
  verifiedAt     DateTime? @map("verified_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  order         Order          @relation(fields: [orderId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  uploadSession UploadSession?
  mediaAnalysis MediaAnalysis?

  @@map("uploaded_assets")
}

model R2File {
  id               String    @id @default(uuid())
  orderId          String?   @map("order_id")
  r2Key            String    @map("r2_key")
  fileType         String    @map("file_type")
  signedUrl        String?   @map("signed_url")
  signedUrlExpires DateTime? @map("signed_url_expires")
  createdAt        DateTime  @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id])

  @@map("r2_files")
}

model EditBrief {
  id              String    @id @default(uuid())
  orderId         String    @map("order_id")
  version         Int       @default(1)
  status          String    @default("draft")
  ambiguityScore  Int       @default(100) @map("ambiguity_score")
  issues          Json      @default("[]")
  approvedAt      DateTime? @map("approved_at")
  promptOriginal  String?   @map("prompt_original")
  promptLanguage  String?   @map("prompt_language")
  promptEn        String?   @map("prompt_en")
  structuredBrief Json?     @map("structured_brief")
  r2Key           String?   @map("r2_key")
  createdAt       DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("edit_briefs")
}

model MediaAnalysis {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  assetId      String    @unique @map("asset_id")
  status       String    @default("processing")
  manifest     Json      @default("{}")
  confidence   Decimal?  @db.Decimal(5, 2)
  issues       Json      @default("[]")
  modelVersion String?   @map("model_version")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  order Order         @relation(fields: [orderId], references: [id])
  asset UploadedAsset @relation(fields: [assetId], references: [id])

  @@index([orderId, status])
  @@map("media_analyses")
}

model EditPlan {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  version      Int       @default(1)
  status       String    @default("draft")
  plan         Json
  confidence   Decimal?  @db.Decimal(5, 2)
  riskFlags    Json      @default("[]") @map("risk_flags")
  modelVersion String?   @map("model_version")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  order    Order             @relation(fields: [orderId], references: [id])
  timeline TimelineManifest?

  @@unique([orderId, version])
  @@map("edit_plans")
}

model TimelineManifest {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  editPlanId    String   @unique @map("edit_plan_id")
  schemaVersion String   @map("schema_version")
  manifest      Json
  checksum      String   @unique
  createdAt     DateTime @default(now()) @map("created_at")

  order    Order    @relation(fields: [orderId], references: [id])
  editPlan EditPlan @relation(fields: [editPlanId], references: [id])

  @@map("timeline_manifests")
}

model QualityCheck {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  renderId       String   @unique @map("render_id")
  qaType         String   @default("draft") @map("qa_type")
  status         String
  checks         Json
  technicalScore Decimal? @map("technical_score") @db.Decimal(5, 2)
  creativeScore  Decimal? @map("creative_score") @db.Decimal(5, 2)
  requiresHuman  Boolean  @default(false) @map("requires_human")
  completedAt    DateTime @default(now()) @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  order  Order  @relation(fields: [orderId], references: [id])
  render Render @relation(fields: [renderId], references: [id])

  @@index([status, requiresHuman])
  @@map("quality_checks")
}

model Render {
  id              String    @id @default(uuid())
  orderId         String    @map("order_id")
  renderType      String    @map("render_type")
  status          String    @default("queued")
  worker          String?
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  durationSeconds Int?      @map("duration_seconds")
  outputR2Key     String?   @map("output_r2_key")
  errorLog        String?   @map("error_log")
  idempotencyKey  String?   @unique @map("idempotency_key")
  progress        Int       @default(0)
  reservedCredits Int       @default(0) @map("reserved_credits")
  actualCredits   Int       @default(0) @map("actual_credits")
  outputChecksum  String?   @map("output_checksum")
  leaseExpiresAt  DateTime? @map("lease_expires_at")

  order          Order           @relation(fields: [orderId], references: [id])
  renderCostLogs RenderCostLog[]
  attempts       RenderAttempt[]
  qualityCheck   QualityCheck?

  @@map("renders")
}

model Revision {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  revisionNumber Int      @map("revision_number")
  customerNotes  String?  @map("customer_notes")
  status         String   @default("requested")
  createdAt      DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("revisions")
}

model DeliveryLink {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  r2Key        String?   @map("r2_key")
  signedUrl    String?   @map("signed_url")
  expiresAt    DateTime? @map("expires_at")
  downloadedAt DateTime? @map("downloaded_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("delivery_links")
}

model CostLog {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  costType    String   @map("cost_type")
  amount      Decimal  @db.Decimal(10, 4)
  currency    String   @default("USD")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("cost_logs")
}

model AiUsageLog {
  id            String   @id @default(uuid())
  orderId       String?  @map("order_id")
  model         String
  provider      String   @default("anthropic")
  promptVersion String?  @map("prompt_version")
  purpose       String
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
  costUsd       Decimal  @map("cost_usd") @db.Decimal(10, 6)
  createdAt     DateTime @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id])

  @@map("ai_usage_logs")
}

model RenderCostLog {
  id               String   @id @default(uuid())
  renderId         String   @map("render_id")
  orderId          String   @map("order_id")
  worker           String
  durationSeconds  Int?     @map("duration_seconds")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(10, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  render Render @relation(fields: [renderId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@map("render_cost_logs")
}

model StorageCostLog {
  id                   String   @id @default(uuid())
  orderId              String   @map("order_id")
  r2GbStored           Decimal  @map("r2_gb_stored") @db.Decimal(10, 4)
  estimatedMonthlyCost Decimal  @map("estimated_monthly_cost_usd") @db.Decimal(10, 4)
  recordedAt           DateTime @default(now()) @map("recorded_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("storage_cost_logs")
}

model LedgerEntry {
  id          String   @id @default(uuid())
  orderId     String?  @map("order_id")
  invoiceId   String?  @map("invoice_id")
  entryType   String   @map("entry_type")
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order?   @relation(fields: [orderId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("ledger_entries")
}

model ProfitReport {
  id              String   @id @default(uuid())
  orderId         String   @unique @map("order_id")
  grossRevenue    Decimal  @map("gross_revenue") @db.Decimal(10, 2)
  gatewayFee      Decimal  @map("gateway_fee") @db.Decimal(10, 2)
  netReceived     Decimal  @map("net_received") @db.Decimal(10, 2)
  aiCost          Decimal  @map("ai_cost") @db.Decimal(10, 4)
  renderCost      Decimal  @map("render_cost") @db.Decimal(10, 4)
  storageCost     Decimal  @map("storage_cost") @db.Decimal(10, 4)
  revisionCost    Decimal  @map("revision_cost") @db.Decimal(10, 4)
  totalDirectCost Decimal  @map("total_direct_cost") @db.Decimal(10, 4)
  grossProfit     Decimal  @map("gross_profit") @db.Decimal(10, 2)
  profitMargin    Decimal  @map("profit_margin") @db.Decimal(5, 2)
  costCapUsedPct  Decimal  @map("cost_cap_used_pct") @db.Decimal(5, 2)
  calculatedAt    DateTime @default(now()) @map("calculated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("profit_reports")
}

model AccountingExport {
  id          String   @id @default(uuid())
  exportType  String   @map("export_type")
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  r2Key       String?  @map("r2_key")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("accounting_exports")
}

model QueueJob {
  id          String    @id @default(uuid())
  orderId     String    @map("order_id")
  jobType     String    @map("job_type")
  status      String    @default("pending")
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("queue_jobs")
}

model JobLead {
  id                 String   @id @default(uuid())
  externalId         String?  @map("external_id")
  connectorId        String?  @map("connector_id")
  source             String
  sourceUrl          String?  @map("source_url")
  title              String
  description        String?
  industry           String?
  serviceFamily      String?  @map("service_family")
  category           String?
  subcategory        String?
  deliverables       Json     @default("[]")
  requiredSkills     Json     @default("[]") @map("required_skills")
  location           String?
  language           String?
  engagementModel    String?  @map("engagement_model")
  budgetType         String?  @map("budget_type")
  budgetMin          Decimal? @map("budget_min") @db.Decimal(10, 2)
  budgetMax          Decimal? @map("budget_max") @db.Decimal(10, 2)
  currency           String?
  deadline           String?
  score              Decimal? @db.Decimal(5, 2)
  legitimacyScore    Decimal? @map("legitimacy_score") @db.Decimal(5, 2)
  capabilityScore    Decimal? @map("capability_score") @db.Decimal(5, 2)
  profitabilityScore Decimal? @map("profitability_score") @db.Decimal(5, 2)
  riskScore          Decimal? @map("risk_score") @db.Decimal(5, 2)
  productRoute       String?  @map("product_route")
  routeDecision      String?  @map("route_decision")
  riskFlags          Json     @default("[]") @map("risk_flags")
  policyStatus       String   @default("review_required") @map("policy_status")
  scoreBreakdown     Json?    @map("score_breakdown")
  pipelineStatus     String   @default("new_lead") @map("pipeline_status")
  rawSnapshot        Json?    @map("raw_snapshot")
  matchedKeyword     String?  @map("matched_keyword")
  draftOrderId       String?  @unique @map("draft_order_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  proposals  ProposalDraft[]
  draftOrder Order?                @relation(fields: [draftOrderId], references: [id])
  connector  SourceConnector?      @relation(fields: [connectorId], references: [id])
  contracts  OpportunityContract[]

  @@unique([source, externalId])
  @@index([category, pipelineStatus])
  @@index([productRoute, pipelineStatus])
  @@map("job_leads")
}

model ProposalDraft {
  id              String    @id @default(uuid())
  jobLeadId       String    @map("job_lead_id")
  draftText       String?   @map("draft_text")
  aiModel         String?   @map("ai_model")
  adminEditedText String?   @map("admin_edited_text")
  status          String    @default("draft")
  adminId         String?   @map("admin_id")
  submittedAt     DateTime? @map("submitted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  jobLead JobLead @relation(fields: [jobLeadId], references: [id])

  @@map("proposal_drafts")
}

model SourceConnector {
  id               String    @id @default(uuid())
  name             String    @unique
  connectorType    String    @map("connector_type")
  collectionMethod String    @map("collection_method")
  permissionMethod String    @map("permission_method")
  policyStatus     String    @default("review_required") @map("policy_status")
  health           String    @default("disabled")
  authStatus       String    @default("not_connected") @map("auth_status")
  enabled          Boolean   @default(false)
  allowedActions   Json      @default("[]") @map("allowed_actions")
  retentionDays    Int?      @map("retention_days")
  rateLimit        Json      @default("{}") @map("rate_limit")
  configuration    Json      @default("{}")
  lastRunAt        DateTime? @map("last_run_at")
  lastSuccessAt    DateTime? @map("last_success_at")
  errorRate        Decimal   @default(0) @map("error_rate") @db.Decimal(5, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  leads JobLead[]

  @@map("source_connectors")
}

model SearchCampaign {
  id               String    @id @default(uuid())
  name             String
  enabled          Boolean   @default(false)
  categories       Json      @default("[]")
  keywords         Json      @default("[]")
  excludedKeywords Json      @default("[]") @map("excluded_keywords")
  locations        Json      @default("[]")
  languages        Json      @default("[]")
  sources          Json      @default("[]")
  productRoutes    Json      @default("[]") @map("product_routes")
  minimumBudget    Decimal?  @map("minimum_budget") @db.Decimal(10, 2)
  minimumMargin    Decimal?  @map("minimum_margin") @db.Decimal(5, 2)
  schedule         String?
  lastRunAt        DateTime? @map("last_run_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("search_campaigns")
}

model OpportunityContract {
  id             String    @id @default(uuid())
  jobLeadId      String?   @map("job_lead_id")
  title          String
  clientName     String?   @map("client_name")
  clientCompany  String?   @map("client_company")
  clientEmail    String?   @map("client_email")
  clientCountry  String?   @map("client_country")
  source         String?
  productRoutes  Json      @default("[]") @map("product_routes")
  status         String    @default("intake_required")
  agreedRevenue  Decimal?  @map("agreed_revenue") @db.Decimal(10, 2)
  currency       String    @default("USD")
  externalFees   Decimal   @default(0) @map("external_fees") @db.Decimal(10, 2)
  estimatedCost  Decimal?  @map("estimated_cost") @db.Decimal(10, 2)
  expectedMargin Decimal?  @map("expected_margin") @db.Decimal(5, 2)
  deadline       DateTime?
  paymentStatus  String    @default("pending") @map("payment_status")
  contractRisk   String    @default("unassessed") @map("contract_risk")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  jobLead        JobLead?               @relation(fields: [jobLeadId], references: [id])
  interview      CustomerInterview?
  specifications ProductSpecification[]

  @@index([status, createdAt])
  @@map("opportunity_contracts")
}

model CustomerInterview {
  id                     String    @id @default(uuid())
  contractId             String    @unique @map("contract_id")
  status                 String    @default("not_started")
  completionPercent      Int       @default(0) @map("completion_percent")
  ambiguityScore         Int       @default(100) @map("ambiguity_score")
  missingAnswers         Json      @default("[]") @map("missing_answers")
  missingAssets          Json      @default("[]") @map("missing_assets")
  conflicts              Json      @default("[]")
  scopeChangeRisk        Decimal   @default(0) @map("scope_change_risk") @db.Decimal(5, 2)
  transcript             Json      @default("[]")
  assignedOperatorId     String?   @map("assigned_operator_id")
  lastCustomerResponseAt DateTime? @map("last_customer_response_at")
  completedAt            DateTime? @map("completed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  contract       OpportunityContract    @relation(fields: [contractId], references: [id])
  specifications ProductSpecification[]

  @@index([status, ambiguityScore])
  @@map("customer_interviews")
}

model ProductSpecification {
  id                 String    @id @default(uuid())
  contractId         String    @map("contract_id")
  interviewId        String?   @map("interview_id")
  productRoute       String    @map("product_route")
  version            Int       @default(1)
  status             String    @default("draft")
  requirements       Json      @default("{}")
  assumptions        Json      @default("[]")
  acceptanceCriteria Json      @default("[]") @map("acceptance_criteria")
  estimatedCost      Decimal?  @map("estimated_cost") @db.Decimal(10, 2)
  quoteAmount        Decimal?  @map("quote_amount") @db.Decimal(10, 2)
  currency           String    @default("USD")
  expectedMargin     Decimal?  @map("expected_margin") @db.Decimal(5, 2)
  immutableHash      String?   @map("immutable_hash")
  approvedAt         DateTime? @map("approved_at")
  customerApprovedAt DateTime? @map("customer_approved_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  contract  OpportunityContract @relation(fields: [contractId], references: [id])
  interview CustomerInterview?  @relation(fields: [interviewId], references: [id])

  @@unique([contractId, productRoute, version])
  @@map("product_specifications")
}

model Testimonial {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  userId            String?  @map("user_id")
  reviewText        String?  @map("review_text")
  consentShowVideo  Boolean  @default(false) @map("consent_show_video")
  consentShowPrompt Boolean  @default(false) @map("consent_show_prompt")
  consentHideName   Boolean  @default(false) @map("consent_hide_name")
  consentHideBrand  Boolean  @default(false) @map("consent_hide_brand")
  status            String   @default("pending")
  published         Boolean  @default(false)
  showcaseR2Key     String?  @map("showcase_r2_key")
  adminId           String?  @map("admin_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("testimonials")
}

model AdminAction {
  id         String   @id @default(uuid())
